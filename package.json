{
  "name": "mago_api",
  "version": "1.0.0",
  "description": "",
  "main": "build/src/server.js",
  "scripts": {
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node build/src/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "sequelize": "./node_modules/.bin/sequelize",
    "db:create": "npx sequelize-cli db:create",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:drop": "npx sequelize-cli db:drop",
    "db:create:model": "npx sequelize-cli model:generate --name",
    "db:create:migration": "npx sequelize-cli migration:generate --name",
    "db:create:seed": "npx sequelize-cli seed:generate --name",
    "db:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:undo:seed": "npx sequelize-cli db:seed:undo:all",
    "db:undo:migration": "npx sequelize-cli db:migrate:undo",
    "db:undo:seed:specific": "npx sequelize-cli db:seed:undo --seed",
    "db:undo:migration:specific": "npx sequelize-cli db:migrate:undo --name",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:reset:hard": "npm run db:drop && npm run db:create && npm run db:migrate",
    "db:reset:soft": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-useragent": "^1.0.2",
    "@types/figlet": "^1.5.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/luxon": "^3.3.2",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.6.0",
    "@types/validator": "^13.11.1",
    "sequelize-cli": "^6.6.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.3.0",
    "@sendgrid/mail": "^7.7.0",
    "app-root-path": "^3.1.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "celebrate": "^15.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-useragent": "^1.0.15",
    "express-winston": "^4.2.0",
    "figlet": "^1.6.0",
    "jsonwebtoken": "^9.0.1",
    "luxon": "^3.4.3",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.1",
    "node-cron": "^3.0.2",
    "nodemon": "^3.0.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.33.0",
    "winston": "^3.10.0"
  }
}
